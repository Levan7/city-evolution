#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
# LLVM windres does not accept GCC's -MD/-MF depfile options emitted by newer Ninja rules.
import subprocess,sys
from pathlib import Path
args=[];dep=None;i=1
while i<len(sys.argv):
    a=sys.argv[i]
    if a=='-MD':i+=1;continue
    if a=='-MF':dep=sys.argv[i+1];i+=2;continue
    args.append(a);i+=1
result=subprocess.run([r'@LINCITY_LLVM_MINGW_ROOT@/bin/x86_64-w64-mingw32-windres',*args])
if result.returncode==0 and dep:
    def esc(p):return p.replace('\\','/').replace(' ','\\ ')
    Path(dep).write_text(esc(args[-1])+': '+esc(args[-2])+'\n')
sys.exit(result.returncode)
