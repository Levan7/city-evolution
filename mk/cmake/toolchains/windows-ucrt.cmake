# LLVM-MinGW UCRT cross-build. Set both paths when configuring a fresh build.
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES LINCITY_LLVM_MINGW_ROOT LINCITY_WIN_SDK_ROOT)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(LINCITY_LLVM_MINGW_ROOT "" CACHE PATH "LLVM-MinGW UCRT toolchain root")
set(LINCITY_WIN_SDK_ROOT "" CACHE PATH "Windows C dependencies SDK root")
if(NOT EXISTS "${LINCITY_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++")
  message(FATAL_ERROR "Set LINCITY_LLVM_MINGW_ROOT to the extracted UCRT toolchain")
endif()
set(CMAKE_C_COMPILER "${LINCITY_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${LINCITY_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++")
configure_file("${CMAKE_CURRENT_LIST_DIR}/llvm-windres.py.in" "${CMAKE_BINARY_DIR}/llvm-windres.py" @ONLY)
file(CHMOD "${CMAKE_BINARY_DIR}/llvm-windres.py" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
set(CMAKE_RC_COMPILER "${CMAKE_BINARY_DIR}/llvm-windres.py")
set(CMAKE_FIND_ROOT_PATH "${LINCITY_WIN_SDK_ROOT}" "${LINCITY_LLVM_MINGW_ROOT}/x86_64-w64-mingw32")
set(CMAKE_PREFIX_PATH "${LINCITY_WIN_SDK_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
# Compile every C++ dependency with this compiler. Keep the C++ runtime private.
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static-libstdc++")
