<?xml version='1.0' encoding='UTF-8'?>
<?xml-stylesheet href="dialogs.xsl" type="text/xsl"?><Dialog width="400" height="465">
	<title>Harbour Trade Settings</title>
	<contents>
		<TableLayout rows="7" cols="3">
			<colsize col="1" relative="1.3"/>
			<colsize col="2" relative="1"/>
			<colsize col="3" relative="1"/>

			<cell row="1" col="1" valign="center" halign="center">
				<Paragraph style="messagebold" translatable="yes" halign="center">
				Product</Paragraph>
			</cell>
			<cell row="1" col="2" halign="center" valign="center">
