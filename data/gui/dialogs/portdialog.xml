	<buttonbar>
		<TableLayout rows="1" cols="2">
			<cell row="1" col="1">
				<Button name="goto">
					<image src="images/gui/info/info.png"/>
				</Button>
			</cell>
			<cell row="1" col="2">
				<Button name="Apply">
					<image src="images/gui/dialogs/okaybutton.png"/>
				</Button>
			</cell>
		</TableLayout>
