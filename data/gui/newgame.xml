<?xml version='1.0' encoding='UTF-8'?>
<?xml-stylesheet href="identity.xsl" type="text/xsl"?>
<Panel name="newgame-menu" resizable="true">
<DefineStyle name="world-heading" color="#e0eff8" font-size="22" font-weight="bold"/>
<DefineStyle name="world-value" color="#e0eff8" font-size="20"/>
<DefineStyle name="world-note" color="#e0eff8" font-size="18"/>
<DefineStyle name="world-button" color="#e0eff8" font-size="22" margin-left="12"/>
<Image src="images/evolution/settings-bg.png" resizable="yes"/>
<TableLayout rows="3" cols="3">
<colsize col="1" relative="0.3"/><colsize col="2" relative="10"/><colsize col="3" relative="0.3"/>
<rowsize row="1" relative="1.3"/><rowsize row="2" relative="9"/><rowsize row="3" relative="1.2"/>
<cell row="1" col="2"><Paragraph style="menutitle">CREATE YOUR WORLD</Paragraph></cell>
<cell row="2" col="2"><TableLayout rows="1" cols="3"><colsize col="1" relative="1"/><colsize col="2" relative="1"/><colsize col="3" relative="1"/><cell row="1" col="1"><TableLayout rows="8" cols="1">
<rowsize row="1" relative="0.5"/>
<cell row="1" col="1"><Paragraph style="world-heading">WORLD SETTINGS</Paragraph></cell>
<cell row="2" col="1"><Paragraph style="world-note">Choose how much land you want.</Paragraph></cell>
<cell row="3" col="1"><TableLayout rows="1" cols="3"><colsize col="1" relative="1"/><colsize col="2" relative="9"/><colsize col="3" relative="1"/>
<cell row="1" col="1"><CheckButton name="MapSizePrev"><text style="button">&lt;</text></CheckButton></cell>
<cell row="1" col="2"><Paragraph name="MapSizeParagraph" style="world-value">Medium-small 100 x 100</Paragraph></cell>
<cell row="1" col="3"><CheckButton name="MapSizeNext"><text style="button">&gt;</text></CheckButton></cell>
</TableLayout></cell>
<cell row="4" col="1"><TableLayout rows="1" cols="2"><colsize col="1" relative="8"/><colsize col="2" relative="1"/>
<cell row="1" col="1"><Paragraph style="world-value">Start with a village</Paragraph></cell>
<cell row="1" col="2"><CheckButton name="WithVillage"><image src="images/gui/checkbox/checkbox.png"/><image-checked src="images/gui/checkbox/checkbox_checked.png"/></CheckButton></cell></TableLayout></cell>
<cell row="5" col="1"><TableLayout rows="1" cols="2"><colsize col="1" relative="8"/><colsize col="2" relative="1"/>
<cell row="1" col="1"><Paragraph style="world-value">Remove trees</Paragraph></cell>
<cell row="1" col="2"><CheckButton name="WithoutTrees"><image src="images/gui/checkbox/checkbox.png"/><image-checked src="images/gui/checkbox/checkbox_checked.png"/></CheckButton></cell></TableLayout></cell>
<cell row="6" col="1"><Paragraph name="WorldSetupSummary" style="world-note">Empty world: no buildings or roads. Start with $200,000.</Paragraph></cell>
<cell row="7" col="1"><Paragraph style="world-note">Larger maps take longer to generate and simulate.</Paragraph></cell>
<cell row="8" col="1"><Paragraph style="world-note">Size changes apply to NEW worlds. Existing cities keep their boundaries.</Paragraph></cell>
</TableLayout></cell><cell row="1" col="2"><TableLayout rows="9" cols="1"><rowsize row="1" fixed="44"/><cell row="1" col="1"><Paragraph style="world-heading">LANDSCAPE</Paragraph></cell><cell row="2" col="1" halign="center" valign="center"><CheckButton name="RiverDelta" auto-uncheck="false" width="280" height="44"><text-caption color="#ffffff" font-size="18" font-weight="bold" halign="center" width="260">River delta</text-caption><image src="images/readable/choice-normal.png"/><image-hover src="images/readable/choice-hover.png"/><image-clicked src="images/readable/choice-hover.png"/><image-checked src="images/readable/choice-hover.png"/></CheckButton></cell><cell row="3" col="1" halign="center" valign="center"><CheckButton name="DesertArea" auto-uncheck="false" width="280" height="44"><text-caption color="#ffffff" font-size="18" font-weight="bold" halign="center" width="260">Semi desert</text-caption><image src="images/readable/choice-normal.png"/><image-hover src="images/readable/choice-hover.png"/><image-clicked src="images/readable/choice-hover.png"/><image-checked src="images/readable/choice-hover.png"/></CheckButton></cell><cell row="4" col="1" halign="center" valign="center"><CheckButton name="TemperateArea" auto-uncheck="false" width="280" height="44"><text-caption color="#ffffff" font-size="18" font-weight="bold" halign="center" width="260">Temperate</text-caption><image src="images/readable/choice-normal.png"/><image-hover src="images/readable/choice-hover.png"/><image-clicked src="images/readable/choice-hover.png"/><image-checked src="images/readable/choice-hover.png"/></CheckButton></cell><cell row="5" col="1" halign="center" valign="center"><CheckButton name="SwampArea" auto-uncheck="false" width="280" height="44"><text-caption color="#ffffff" font-size="18" font-weight="bold" halign="center" width="260">Swamp</text-caption><image src="images/readable/choice-normal.png"/><image-hover src="images/readable/choice-hover.png"/><image-clicked src="images/readable/choice-hover.png"/><image-checked src="images/readable/choice-hover.png"/></CheckButton></cell><cell row="6" col="1" halign="center" valign="center"><CheckButton name="BarrenArea" auto-uncheck="false" width="280" height="44"><text-caption color="#ffffff" font-size="18" font-weight="bold" halign="center" width="260">Barren flatland</text-caption><image src="images/readable/choice-normal.png"/><image-hover src="images/readable/choice-hover.png"/><image-clicked src="images/readable/choice-hover.png"/><image-checked src="images/readable/choice-hover.png"/></CheckButton></cell><cell row="9" col="1"><Paragraph style="world-note">Barren land has no trees, roads or buildings.</Paragraph></cell></TableLayout></cell><cell row="1" col="3"><TableLayout rows="9" cols="1"><rowsize row="1" fixed="44"/><cell row="1" col="1"><Paragraph style="world-heading">READY-MADE CITIES</Paragraph></cell><cell row="2" col="1" halign="center" valign="center"><CheckButton name="File0" auto-uncheck="false" width="280" height="44"><text-caption color="#ffffff" font-size="18" font-weight="bold" halign="center" width="260">Scenario 1234567890</text-caption><image src="images/readable/choice-normal.png"/><image-hover src="images/readable/choice-hover.png"/><image-clicked src="images/readable/choice-hover.png"/><image-checked src="images/readable/choice-hover.png"/></CheckButton></cell><cell row="3" col="1" halign="center" valign="center"><CheckButton name="File1" auto-uncheck="false" width="280" height="44"><text-caption color="#ffffff" font-size="18" font-weight="bold" halign="center" width="260">Scenario 1234567890</text-caption><image src="images/readable/choice-normal.png"/><image-hover src="images/readable/choice-hover.png"/><image-clicked src="images/readable/choice-hover.png"/><image-checked src="images/readable/choice-hover.png"/></CheckButton></cell><cell row="4" col="1" halign="center" valign="center"><CheckButton name="File2" auto-uncheck="false" width="280" height="44"><text-caption color="#ffffff" font-size="18" font-weight="bold" halign="center" width="260">Scenario 1234567890</text-caption><image src="images/readable/choice-normal.png"/><image-hover src="images/readable/choice-hover.png"/><image-clicked src="images/readable/choice-hover.png"/><image-checked src="images/readable/choice-hover.png"/></CheckButton></cell><cell row="5" col="1" halign="center" valign="center"><CheckButton name="File3" auto-uncheck="false" width="280" height="44"><text-caption color="#ffffff" font-size="18" font-weight="bold" halign="center" width="260">Scenario 1234567890</text-caption><image src="images/readable/choice-normal.png"/><image-hover src="images/readable/choice-hover.png"/><image-clicked src="images/readable/choice-hover.png"/><image-checked src="images/readable/choice-hover.png"/></CheckButton></cell><cell row="6" col="1" halign="center" valign="center"><CheckButton name="File4" auto-uncheck="false" width="280" height="44"><text-caption color="#ffffff" font-size="18" font-weight="bold" halign="center" width="260">Scenario 1234567890</text-caption><image src="images/readable/choice-normal.png"/><image-hover src="images/readable/choice-hover.png"/><image-clicked src="images/readable/choice-hover.png"/><image-checked src="images/readable/choice-hover.png"/></CheckButton></cell><cell row="7" col="1" halign="center" valign="center"><CheckButton name="File5" auto-uncheck="false" width="280" height="44"><text-caption color="#ffffff" font-size="18" font-weight="bold" halign="center" width="260">Scenario 1234567890</text-caption><image src="images/readable/choice-normal.png"/><image-hover src="images/readable/choice-hover.png"/><image-clicked src="images/readable/choice-hover.png"/><image-checked src="images/readable/choice-hover.png"/></CheckButton></cell><cell row="9" col="1"><Paragraph style="world-note">These cities have their own map size.</Paragraph></cell></TableLayout></cell></TableLayout></cell>
<cell row="3" col="2"><TableLayout rows="1" cols="2">
<cell row="1" col="1" halign="left"><Button name="BackButton"><text-caption style="button" halign="center">Back</text-caption><image src="images/mainmenu/buttons/back.png"/><image-hover src="images/mainmenu/buttons/back-hover.png"/><image-clicked src="images/mainmenu/buttons/back-clicked.png"/></Button></cell>
<cell row="1" col="2" halign="right"><Button name="StartButton"><text-caption style="button" halign="center">Create World</text-caption><image src="images/mainmenu/buttons/start.png"/><image-hover src="images/mainmenu/buttons/start-hover.png"/><image-clicked src="images/mainmenu/buttons/start-clicked.png"/></Button></cell>
</TableLayout></cell></TableLayout>
</Panel>
