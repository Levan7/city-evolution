<?xml version='1.0' encoding='UTF-8'?>
<?xml-stylesheet href="identity.xsl" type="text/xsl"?>
<Window name="PortTradeHistory" width="704" height="510" border="10" titlesize="32" resizable="no">
  <title><Paragraph color="#f1efdf" font-size="22">Port trade history</Paragraph></title>
  <background><FilledRectangle color="#14252dff"/></background>
  <title-background><FilledRectangle color="#29463fff"/></title-background>
  <closebutton><text color="white">X</text></closebutton>
  <contents>
    <TableLayout rows="13" cols="6">
    <rowsize row="1" fixed="44"/>
    <rowsize row="2" fixed="28"/>
    <rowsize row="3" fixed="128"/>
    <rowsize row="4" fixed="27"/>
    <rowsize row="5" fixed="25"/>
    <rowsize row="6" fixed="30"/>
    <rowsize row="7" fixed="27"/>
    <rowsize row="8" fixed="23"/>
    <rowsize row="9" fixed="23"/>
    <rowsize row="10" fixed="23"/>
    <rowsize row="11" fixed="23"/>
    <rowsize row="12" fixed="23"/>
    <rowsize row="13" fixed="23"/>
    <cell row="1" col="1" valign="center" halign="center">
      <Button name="TradeRange1" width="104" height="32">
        <image src="images/readable/plate-72-normal.png" width="104" height="32" resizable="yes"/>
        <image-hover src="images/readable/plate-72-hover.png" width="104" height="32" resizable="yes"/>
        <text-caption color="#edf0df" halign="center" font-size="15">1 Month</text-caption>
      </Button>
    </cell>
    <cell row="1" col="2" valign="center" halign="center">
      <Button name="TradeRange12" width="104" height="32">
        <image src="images/readable/plate-72-normal.png" width="104" height="32" resizable="yes"/>
        <image-hover src="images/readable/plate-72-hover.png" width="104" height="32" resizable="yes"/>
        <text-caption color="#edf0df" halign="center" font-size="15">1 Year</text-caption>
      </Button>
    </cell>
    <cell row="1" col="3" valign="center" halign="center">
      <Button name="TradeRange60" width="104" height="32">
        <image src="images/readable/plate-72-normal.png" width="104" height="32" resizable="yes"/>
        <image-hover src="images/readable/plate-72-hover.png" width="104" height="32" resizable="yes"/>
        <text-caption color="#edf0df" halign="center" font-size="15">5 Years</text-caption>
      </Button>
    </cell>
    <cell row="1" col="4" valign="center" halign="center">
      <Button name="TradeRange120" width="104" height="32">
        <image src="images/readable/plate-72-normal.png" width="104" height="32" resizable="yes"/>
        <image-hover src="images/readable/plate-72-hover.png" width="104" height="32" resizable="yes"/>
        <text-caption color="#edf0df" halign="center" font-size="15">10 Years</text-caption>
      </Button>
    </cell>
    <cell row="1" col="5" valign="center" halign="center">
      <Button name="TradeRange600" width="104" height="32">
        <image src="images/readable/plate-72-normal.png" width="104" height="32" resizable="yes"/>
        <image-hover src="images/readable/plate-72-hover.png" width="104" height="32" resizable="yes"/>
        <text-caption color="#edf0df" halign="center" font-size="15">50 Years</text-caption>
      </Button>
    </cell>
    <cell row="1" col="6" valign="center" halign="center">
      <Button name="TradeRange1200" width="104" height="32">
        <image src="images/readable/plate-72-normal.png" width="104" height="32" resizable="yes"/>
        <image-hover src="images/readable/plate-72-hover.png" width="104" height="32" resizable="yes"/>
        <text-caption color="#edf0df" halign="center" font-size="15">100 Years</text-caption>
      </Button>
    </cell>
    <cell row="2" col="1" colspan="6" valign="center"><Paragraph name="TradePeriod" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    <cell row="3" col="1" colspan="6"><PortTradeChart name="TradeChart"/></cell>
    <cell row="4" col="1" colspan="6" valign="center"><Paragraph name="TradeScale" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    <cell row="5" col="1" colspan="3" valign="center"><Paragraph name="TradeImports" color="#63b1e7" font-size="17" halign="center"></Paragraph></cell>
    <cell row="5" col="4" colspan="3" valign="center"><Paragraph name="TradeExports" color="#f6b76b" font-size="17" halign="center"></Paragraph></cell>
    <cell row="6" col="1" colspan="6" valign="center"><Paragraph name="TradeCurrent" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    <cell row="7" col="1" colspan="2" valign="center"><Paragraph color="#edf0df" font-size="15" halign="left">Product</Paragraph></cell>
    <cell row="7" col="3" colspan="2" valign="center"><Paragraph color="#edf0df" font-size="15" halign="center">Imported units</Paragraph></cell>
    <cell row="7" col="5" colspan="2" valign="center"><Paragraph color="#edf0df" font-size="15" halign="center">Exported units</Paragraph></cell>
    <cell row="8" col="1" colspan="2" valign="center"><Paragraph name="TradeItem0" color="#edf0df" font-size="15" halign="left"></Paragraph></cell>
    <cell row="8" col="3" colspan="2" valign="center"><Paragraph name="TradeIn0" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    <cell row="8" col="5" colspan="2" valign="center"><Paragraph name="TradeOut0" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    <cell row="9" col="1" colspan="2" valign="center"><Paragraph name="TradeItem1" color="#edf0df" font-size="15" halign="left"></Paragraph></cell>
    <cell row="9" col="3" colspan="2" valign="center"><Paragraph name="TradeIn1" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    <cell row="9" col="5" colspan="2" valign="center"><Paragraph name="TradeOut1" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    <cell row="10" col="1" colspan="2" valign="center"><Paragraph name="TradeItem2" color="#edf0df" font-size="15" halign="left"></Paragraph></cell>
    <cell row="10" col="3" colspan="2" valign="center"><Paragraph name="TradeIn2" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    <cell row="10" col="5" colspan="2" valign="center"><Paragraph name="TradeOut2" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    <cell row="11" col="1" colspan="2" valign="center"><Paragraph name="TradeItem3" color="#edf0df" font-size="15" halign="left"></Paragraph></cell>
    <cell row="11" col="3" colspan="2" valign="center"><Paragraph name="TradeIn3" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    <cell row="11" col="5" colspan="2" valign="center"><Paragraph name="TradeOut3" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    <cell row="12" col="1" colspan="2" valign="center"><Paragraph name="TradeItem4" color="#edf0df" font-size="15" halign="left"></Paragraph></cell>
    <cell row="12" col="3" colspan="2" valign="center"><Paragraph name="TradeIn4" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    <cell row="12" col="5" colspan="2" valign="center"><Paragraph name="TradeOut4" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    <cell row="13" col="1" colspan="2" valign="center"><Paragraph name="TradeItem5" color="#edf0df" font-size="15" halign="left"></Paragraph></cell>
    <cell row="13" col="3" colspan="2" valign="center"><Paragraph name="TradeIn5" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    <cell row="13" col="5" colspan="2" valign="center"><Paragraph name="TradeOut5" color="#edf0df" font-size="15" halign="center"></Paragraph></cell>
    </TableLayout>
  </contents>
</Window>
